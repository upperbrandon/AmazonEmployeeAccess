df <- data.frame(x = x1,
y = dbinom(4,7,x1))
df2 <- data.frame(x = x1,
y = dbinom(3,7,x1))
s1 <- ggplot(data = df, aes(x = x, y = y)) +
geom_line(data = df, aes(x = x, y = y, color = "Home")) +
geom_line(data = df2, aes(x = x, y = y, color = "Away")) +
ggtitle("Home vs Away Likelihood") +
xlab("Theta") + ylab("Probability") +
scale_color_manual(name = "Legend",
values = c("Home" = "darkred", "Away" = "skyblue"))
