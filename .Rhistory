library(embed)
# Read and Set ------------------------------------------------------------
setwd("~/GitHub/AmazonEmployeeAccess")
train_data <- vroom("train.csv")
test_data  <- vroom("test.csv")
# Ensure ACTION is a factor -----------------------------------------------
train_data <- train_data %>%
mutate(ACTION = factor(ACTION))
library(keras)
nn_recipe <- recipe(ACTION ~ ., data = train_data) %>%
step_mutate_at(all_numeric_predictors(), fn = as.factor) %>%
step_other(all_nominal_predictors(), threshold = 0.001) %>%
step_dummy(all_nominal_predictors()) %>%
step_range(all_numeric_predictors(), min = 0, max = 1)
nn_model <- mlp(
hidden_units = tune(),
penalty = tune(),
epochs = 100
) %>%
set_engine("keras") %>%
set_mode("classification")
# Workflow
nn_wf <- workflow() %>%
add_recipe(nn_recipe) %>%
add_model(nn_model)
# Tuning grid
nn_grid <- grid_regular(
hidden_units(range = c(1, 19)),
penalty(range = c(-4, 0)),
levels = 5
)
# Cross-validation folds
set.seed(222)
nn_folds <- vfold_cv(train_data, v = 3, strata = ACTION)
# Tune the model
nn_tuned <- nn_wf %>%
tune_grid(
resamples = nn_folds,
grid = nn_grid,
metrics = metric_set(roc_auc),
control = control_grid(verbose = TRUE)
)
show_notes(.Last.tune.result)
model <- keras_model_sequential() %>%
layer_dense(units = 64, activation = "relu", input_shape = c(10)) %>%
layer_dense(units = 1)
# Select best
best_nn <- select_best(nn_tuned, metric = "roc_auc")
# Finalize workflow
final_nn <- finalize_workflow(nn_wf, best_nn) %>%
fit(data = train_data)
nn_folds <- vfold_cv(train_data, v = 3, strata = ACTION)
# Tune the model
nn_tuned <- nn_wf %>%
tune_grid(
resamples = nn_folds,
grid = nn_grid,
metrics = metric_set(roc_auc),
control = control_grid(verbose = TRUE)
)
