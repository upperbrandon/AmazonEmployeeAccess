df_home_prior <- dbeta(x,3,2)
df_home_posterior <- dbeta(x,3 + y_home,2 + n_home - y_home)
plot(df_home_prior,xlab = ("theta"),ylab = ("density"), title = "Theta H Prior & Posterior")
lines(df_home_posterior)
df_away_prior <- dbeta(x,2,3)
df_away_posterior <- dbeta(x,2 + y_away,3 + n_away - y_away)
par(mfrow=c(1,2))
plot(df_home_prior,xlab = ("theta"),ylab = ("density"), title = "Theta H Prior & Posterior")
lines(df_home_posterior)
?lines
